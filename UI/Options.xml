<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <Frame name="GearwrightAboutTemplate" mixin="GearwrightAboutMixin" virtual="true">
        <Size y="45"/>
        <Layers>
            <Layer level="OVERLAY">
                <FontString parentKey="Text" inherits="GameFontHighlight" justifyH="LEFT" justifyV="TOP">
                    <Anchors>
                        <!-- x=7 matches SettingsListSectionHeaderTemplate's title -->
                        <Anchor point="TOPLEFT" x="7" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Frame parentKey="Chip">
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture parentKey="Bg" setAllPoints="true">
                            <Color r="1" g="0.82" b="0" a="0.15"/>
                        </Texture>
                    </Layer>
                    <Layer level="OVERLAY">
                        <FontString parentKey="Label" inherits="GameFontNormalSmall" justifyH="CENTER">
                            <Anchors>
                                <Anchor point="CENTER"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
        </Frames>
    </Frame>
</Ui>
